---
import PhosphorPicker from './PhosphorPicker.astro';
import { NAV_ITEMS, type NavPage } from '../lib/nav';
import { siteContent } from '../data/site-content';

export interface Props {
	page?: NavPage;
}

const { page } = Astro.props;
const currentPage = page ?? 'home';
---

<header class="term-header">
	<div class="term-shell term-header-inner">
		<div class="term-brand">
			<img
				class="term-avatar"
				src="https://secure.gravatar.com/avatar/bd76701a5b015803844801dafec0401c?s=80&d=identicon"
				alt=""
				width="26"
				height="26"
				loading="eager"
			/>
			<a class="term-logo" href="/">{siteContent.shared.logo}</a>
		</div>

		<div class="term-header-right">
			<nav class="term-nav" aria-label="Main">
				{
					NAV_ITEMS.map((item) => (
						<a href={item.href} aria-current={item.page === currentPage ? 'page' : undefined}>
							{item.label}
						</a>
					))
				}
			</nav>
			<PhosphorPicker />
		</div>
	</div>
</header>
