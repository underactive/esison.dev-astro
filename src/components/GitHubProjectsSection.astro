---
import { GITHUB_PROJECTS_REQUIRED_TOPIC } from '../consts';
import { getGitHubProjects } from '../lib/github-projects';
import { siteContent } from '../data/site-content';
import FormattedDate from './FormattedDate.astro';

const githubProjects = await getGitHubProjects();
const { github } = siteContent.shared;
---

{
	githubProjects.enabled && (
		<div style="margin-top:4rem">
			<p class="term-section-label">gh repo list --topic {GITHUB_PROJECTS_REQUIRED_TOPIC}</p>
			<h3 class="term-h2">{github.heading}</h3>
			<a class="term-link" href={github.profileUrl} target="_blank" rel="noopener noreferrer">
				{github.profileLinkLabel}
			</a>

			{
				githubProjects.errorMessage ? (
					<div class="term-panel term-panel--warn" style="margin-top:1.75rem">
						<p>{githubProjects.errorMessage}</p>
						<p class="term-panel-note">
							Trigger a new build after GitHub connectivity is restored to refresh this section.
						</p>
					</div>
				) : githubProjects.projects.length === 0 ? (
					<div class="term-panel" style="margin-top:1.75rem">
						<p>
							No public repositories are currently tagged with{' '}
							<code class="term-tag">{GITHUB_PROJECTS_REQUIRED_TOPIC}</code>.
						</p>
					</div>
				) : (
					<>
						{githubProjects.isPartial && (
							<p class="term-note" style="margin-top:1.5rem">
								Some projects may not be shown due to a temporary issue during the build.
							</p>
						)}
						<div class="term-repos">
							{githubProjects.projects.map((project) => (
								<article class="term-repo">
									<div class="term-repo-head">
										<h4 class="term-repo-name">{project.name}</h4>
										{project.stars > 0 && (
											<span class="term-stars">
												★ {project.stars} star{project.stars === 1 ? '' : 's'}
											</span>
										)}
									</div>

									<p class="term-repo-desc">{project.description}</p>

									<div class="term-taglist">
										{project.language && <span class="term-tag">{project.language}</span>}
										{project.topics.map((topic) => (
											<span class="term-tag">{topic}</span>
										))}
									</div>

									<p class="term-repo-meta">
										{github.lastPushLabel} <FormattedDate date={project.pushedAt} />
									</p>

									<div class="term-project-foot">
										<a
											class="term-link"
											href={project.repoUrl}
											target="_blank"
											rel="noopener noreferrer"
										>
											{github.repoLinkLabel}
										</a>
										{project.homepageUrl && (
											<a
												class="term-link"
												href={project.homepageUrl}
												target="_blank"
												rel="noopener noreferrer"
											>
												{github.liveSiteLinkLabel}
											</a>
										)}
									</div>
								</article>
							))}
						</div>
					</>
				)
			}
		</div>
	)
}
