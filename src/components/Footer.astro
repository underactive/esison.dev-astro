---
import { siteContent } from '../data/site-content';

const { shared } = siteContent;
const year = new Date().getFullYear();
---

<footer class="term-shell term-footer">
	<p>{shared.copyright(year)}</p>
	<div class="term-socials">
		{
			shared.socials.map((social) => (
				<a href={social.href} target="_blank" rel="me noopener noreferrer">
					<span class="term-sr-only">{social.label}</span>
					<span aria-hidden="true">
						{social.network}/{social.handle}
					</span>
				</a>
			))
		}
	</div>
</footer>
