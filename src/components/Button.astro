---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'button'> {
	size?: 'sm' | 'md' | 'lg';
}

const { size = 'md', class: className, ...props } = Astro.props;
---

<button class:list={['term-btn', `term-btn--${size}`, className]} {...props}>
	<slot />
</button>

<style>
	.term-btn--sm {
		font-size: 0.75rem;
		padding: 0.4rem 0.8rem;
	}

	.term-btn--lg {
		font-size: 0.95rem;
		padding: 0.75rem 1.4rem;
	}
</style>
