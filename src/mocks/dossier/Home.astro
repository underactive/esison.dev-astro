---
import FormattedDate from '../../components/FormattedDate.astro';
import { siteContent } from '../../data/site-content';

const { home, shared } = siteContent;
const repos = siteContent.fixtures.githubRepos;

// Proportional timeline: map each stint onto the 1997→now span as percentages.
const spanStart = Math.min(...home.history.map((entry) => entry.startYear));
const spanEnd = new Date().getFullYear();
const spanYears = spanEnd - spanStart;
const NARROW_THRESHOLD_PERCENT = 22;

const timeline = home.history
	.map((entry) => {
		const from = ((entry.startYear - spanStart) / spanYears) * 100;
		const to = (((entry.endYear ?? spanEnd) - spanStart) / spanYears) * 100;
		return { ...entry, from, to, narrow: to - from < NARROW_THRESHOLD_PERCENT };
	})
	.sort((a, b) => b.startYear - a.startYear);

const currentRole = home.history.find((entry) => entry.endYear === null);
const allSkills = home.skillGroups.flatMap((group) => group.skills);
---

<section class="dos-shell dos-hero">
	<div class="dos-hero-grid">
		<div>
			<p class="dos-label">Profile</p>
			<h1 class="dos-hero-name">{home.heroName}</h1>
			<ul class="dos-hero-role">
				{home.taglines.map((tagline) => <li>{tagline.text.replace('// ', '')}</li>)}
			</ul>
			<div class="dos-cta-row">
				{
					home.heroCtas.map((cta, index) => (
						<a class:list={['dos-btn', index === 0 && 'dos-btn--primary']} href={cta.href}>
							{cta.label}
						</a>
					))
				}
			</div>
		</div>

		<dl class="dos-facts">
			<div class="dos-fact">
				<dt>Current</dt>
				<dd>{currentRole?.company} &middot; since {currentRole?.startYear}</dd>
			</div>
			<div class="dos-fact">
				<dt>Experience</dt>
				<dd>{spanYears} years &middot; {home.history.length} employers</dd>
			</div>
			<div class="dos-fact">
				<dt>Stack</dt>
				<dd>{allSkills.slice(0, 6).join(', ')} +{allSkills.length - 6} more</dd>
			</div>
			<div class="dos-fact">
				<dt>Repos</dt>
				<dd>{repos.length} public, tagged spotlight</dd>
			</div>
		</dl>
	</div>
</section>

<section id="about" class="dos-shell dos-section">
	<p class="dos-label">{home.aboutHeading}</p>
	<div class="dos-prose">
		<p>
			{
				home.aboutBio.segments.map((segment) => {
					if (segment.kind === 'text') return segment.value;
					if (segment.kind === 'aside') return <span class="dos-aside">{segment.value}</span>;
					return <span class="dos-quote">{segment.value}</span>;
				})
			}
		</p>
	</div>

	<dl class="dos-specs">
		{
			home.skillGroups.map((group) => (
				<div class="dos-spec">
					<dt>{group.title}</dt>
					<dd>{group.skills.join('  ·  ')}</dd>
				</div>
			))
		}
	</dl>

	<div class="dos-bar">
		<p>{home.aboutCta.blurb}</p>
		<a class="dos-btn dos-btn--primary" href="/design-lab/dossier/about/">
			{home.aboutCta.link.label}
		</a>
	</div>
</section>

<section id="portfolio" class="dos-shell dos-section">
	<p class="dos-label">Selected work</p>
	<h2 class="dos-h2">{home.projectsHeading}</h2>
	<p class="dos-prose">{home.projectsSubhead}</p>

	<div class="dos-records">
		{
			home.featuredProjects.map((project, index) => (
				<article class="dos-record">
					<p class="dos-index">{String(index + 1).padStart(2, '0')}</p>
					<div>
						<h3 class="dos-record-name">{project.name}</h3>
						<p class="dos-record-summary">{project.summary}</p>
						{project.notes.map((note) => <p class="dos-note">{note}</p>)}
						<div class="dos-tagrow">
							<span>{project.tags.join(' · ')}</span>
							<a class="dos-link" href={project.href} target="_blank" rel="noopener">
								{project.linkLabel}
							</a>
						</div>
					</div>
					<figure class="dos-record-media">
						{
							project.media.kind === 'image' ? (
								<img src={project.media.src} alt="" loading="lazy" />
							) : (
								<video src={project.media.src} autoplay muted loop playsinline />
							)
						}
					</figure>
				</article>
			))
		}
	</div>

	<div style="margin-top:3rem">
		<p class="dos-label">{shared.github.heading}</p>
		<a class="dos-link" href={shared.github.profileUrl} target="_blank" rel="noopener">
			{shared.github.profileLinkLabel}
		</a>
		<div class="dos-scroll">
			<table class="dos-table">
				<thead>
					<tr>
						<th>Repository</th>
						<th>Description</th>
						<th>Language</th>
						<th>Stars</th>
						<th>Last push</th>
						<th />
					</tr>
				</thead>
				<tbody>
					{
						repos.map((repo) => (
							<tr>
								<td class="dos-table-name">{repo.name}</td>
								<td class="dos-table-desc">{repo.description}</td>
								<td class="dos-table-mono">{repo.language ?? '—'}</td>
								<td class="dos-table-mono">{repo.stars || '—'}</td>
								<td class="dos-table-mono">
									<FormattedDate date={repo.pushedAt} />
								</td>
								<td class="dos-table-mono">
									<a class="dos-link" href={repo.repoUrl} target="_blank" rel="noopener">
										{shared.github.repoLinkLabel}
									</a>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<section id="history" class="dos-shell dos-section">
	<p class="dos-label">Career</p>
	<h2 class="dos-h2">{home.historyHeading.replace(' | ', ', ')}</h2>

	<div class="dos-spine">
		<div class="dos-spine-scale">
			<span>{spanStart}</span>
			<span>{spanStart + Math.round(spanYears / 2)}</span>
			<span>{spanEnd}</span>
		</div>
		{
			timeline.map((entry) => (
				<div
					class="dos-spine-row"
					data-current={entry.endYear === null ? 'true' : 'false'}
					data-narrow={entry.narrow ? 'true' : 'false'}
				>
					<div class="dos-track">
						<div
							class="dos-bar-span"
							style={`--dos-from:${entry.from.toFixed(2)};--dos-to:${entry.to.toFixed(2)}`}
						>
							<span class="dos-bar-label">{entry.company}</span>
						</div>
					</div>
					<span class="dos-spine-years">{entry.period}</span>
				</div>
			))
		}
	</div>
</section>
