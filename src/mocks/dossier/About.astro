---
import { siteContent } from '../../data/site-content';

const { about } = siteContent;
---

<section class="dos-shell dos-page-head">
	<p class="dos-label">Profile</p>
	<h1 class="dos-h1">{about.heading}</h1>
</section>

<section class="dos-shell dos-section">
	<div class="dos-two-col">
		<div class="dos-prose" style="max-width:none">
			{about.workStory.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<div class="dos-prose" style="max-width:none">
			{about.workStory.slice(2).map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</div>

	<div class="dos-bar">
		<div>
			<p class="dos-label" style="margin-bottom:0.35rem">{about.collaborationCta.heading}</p>
			<p>{about.collaborationCta.blurb}</p>
		</div>
		<div class="dos-cta-row" style="margin-top:0">
			{
				about.collaborationCta.actions.map((action) => (
					<span class="dos-btn" aria-disabled="true">
						{action.label}
					</span>
				))
			}
		</div>
	</div>
</section>

<section class="dos-shell dos-section">
	<p class="dos-label">Outside work</p>
	<div class="dos-two-col">
		<div class="dos-prose" style="max-width:none">
			{about.personalStory.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<div class="dos-photos" style="margin-top:0">
			{
				about.photos.map((photo) => (
					<figure class="dos-photo">
						<img src={photo.src} alt={photo.alt} loading="lazy" />
						<figcaption>{photo.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
