---
import MockHead from '../_shared/MockHead.astro';
import { mockPageUrl, MOCK_PAGES, PAGE_LABELS, type MockPage } from '../registry';
import { siteContent } from '../../data/site-content';
import './terminal.css';

export interface Props {
	page: MockPage;
}

const { page } = Astro.props;
const { shared, meta } = siteContent;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<MockHead title={`${meta.siteTitle} — Terminal`} />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="term-root">
			<header class="term-header">
				<div class="term-shell term-header-inner">
					<a class="term-logo" href={mockPageUrl('terminal', 'home')}>{shared.logo}</a>
					<nav class="term-nav">
						{
							MOCK_PAGES.map((p) => (
								<a
									href={mockPageUrl('terminal', p)}
									aria-current={p === page ? 'page' : undefined}
								>
									{PAGE_LABELS[p].toLowerCase()}
								</a>
							))
						}
					</nav>
				</div>
			</header>

			<main>
				<slot />
			</main>

			<footer class="term-shell term-footer">
				<p>{shared.copyright(year)}</p>
				<div class="term-socials">
					{
						shared.socials.map((social) => (
							<a href={social.href} aria-label={social.label} rel="noopener" target="_blank">
								{social.network}/{social.handle}
							</a>
						))
					}
				</div>
			</footer>
		</div>
	</body>
</html>
