---
import MockHead from '../_shared/MockHead.astro';
import { mockPageUrl, MOCK_PAGES, PAGE_LABELS, type MockPage } from '../registry';
import { siteContent } from '../../data/site-content';
import './retro80s.css';

export interface Props {
	page: MockPage;
}

const { page } = Astro.props;
const { shared, meta } = siteContent;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<MockHead title={`${meta.siteTitle} — Retro 80s`} />
		<link
			href="https://fonts.googleapis.com/css2?family=VT323&family=Orbitron:wght@700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="r80-root">
			<div class="r80-layer">
				<header class="r80-header">
					<div class="r80-shell r80-header-inner">
						<a class="r80-logo" href={mockPageUrl('retro80s', 'home')}>{shared.logo}</a>
						<nav class="r80-nav">
							{
								MOCK_PAGES.map((p) => (
									<a
										href={mockPageUrl('retro80s', p)}
										aria-current={p === page ? 'page' : undefined}
									>
										{PAGE_LABELS[p]}
									</a>
								))
							}
						</nav>
					</div>
				</header>

				<main>
					<slot />
				</main>

				<footer class="r80-shell r80-footer">
					<p>{shared.copyright(year)}</p>
					<div class="r80-socials">
						{
							shared.socials.map((social) => (
								<a href={social.href} aria-label={social.label} rel="noopener" target="_blank">
									{social.network}
								</a>
							))
						}
					</div>
				</footer>
			</div>
		</div>
	</body>
</html>
