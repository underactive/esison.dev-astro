---
import { siteContent } from '../../data/site-content';

const { about } = siteContent;
---

<section class="r80-shell r80-page-head">
	<p class="r80-label">Player profile</p>
	<h1 class="r80-chrome r80-h1">{about.heading}</h1>
</section>

<section class="r80-shell r80-section">
	<div class="r80-bezel">
		<div class="r80-prose">
			{about.workStory.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</div>

	<div class="r80-callout">
		<div>
			<p class="r80-label" style="margin-bottom:0.4rem">{about.collaborationCta.heading}</p>
			<p>{about.collaborationCta.blurb}</p>
		</div>
		<div class="r80-cta-row" style="margin-top:0">
			{
				about.collaborationCta.actions.map((action) => (
					<span class="r80-btn" aria-disabled="true">
						{action.label}
					</span>
				))
			}
		</div>
	</div>
</section>

<section class="r80-shell r80-section">
	<p class="r80-label">Continue?</p>
	<div class="r80-prose">
		{about.personalStory.map((paragraph) => <p>{paragraph}</p>)}
	</div>

	<div class="r80-photos">
		{
			about.photos.map((photo) => (
				<figure class="r80-photo">
					<img src={photo.src} alt={photo.alt} loading="lazy" />
					<figcaption>{photo.caption}</figcaption>
				</figure>
			))
		}
	</div>
</section>
