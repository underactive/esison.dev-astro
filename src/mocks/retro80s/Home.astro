---
import FormattedDate from '../../components/FormattedDate.astro';
import { siteContent } from '../../data/site-content';

const { home, shared } = siteContent;
const repos = siteContent.fixtures.githubRepos;
---

<section class="r80-shell r80-hero">
	<div class="r80-bezel">
		<p class="r80-label">Insert coin &middot; Player One</p>
		<h1 class="r80-chrome r80-h1">{home.heroName}</h1>
		<ul class="r80-hero-taglines">
			{home.taglines.map((tagline) => <li>{tagline.text}</li>)}
		</ul>
		<div class="r80-cta-row">
			{home.heroCtas.map((cta) => <a class="r80-btn" href={cta.href}>{cta.label}</a>)}
		</div>
	</div>
</section>

<section id="about" class="r80-shell r80-section">
	<p class="r80-label">Player profile</p>
	<h2 class="r80-chrome r80-h2">{home.aboutHeading}</h2>
	<div class="r80-prose">
		<p>
			{
				home.aboutBio.segments.map((segment) => {
					if (segment.kind === 'text') return segment.value;
					if (segment.kind === 'aside') return <span class="r80-aside">{segment.value}</span>;
					return <span class="r80-quote">{segment.value}</span>;
				})
			}
		</p>
	</div>

	<div class="r80-grid">
		{
			home.skillGroups.map((group) => (
				<article class="r80-card">
					<h3>{group.title}</h3>
					<div class="r80-chips">
						{group.skills.map((skill) => <span class="r80-chip">{skill}</span>)}
					</div>
				</article>
			))
		}
	</div>

	<div class="r80-callout">
		<p>{home.aboutCta.blurb}</p>
		<a class="r80-btn" href="/design-lab/retro80s/about/">{home.aboutCta.link.label}</a>
	</div>
</section>

<section id="portfolio" class="r80-shell r80-section">
	<p class="r80-label">Select stage</p>
	<h2 class="r80-chrome r80-h2">{home.projectsHeading}</h2>
	<p class="r80-prose">{home.projectsSubhead}</p>

	<div class="r80-projects">
		{
			home.featuredProjects.map((project) => (
				<article class="r80-project">
					<div class="r80-screen">
						{
							project.media.kind === 'image' ? (
								<img src={project.media.src} alt="" loading="lazy" />
							) : (
								<video src={project.media.src} autoplay muted loop playsinline />
							)
						}
					</div>
					<div class="r80-project-body">
						<h3 class="r80-project-name">{project.name}</h3>
						<p class="r80-project-summary">{project.summary}</p>
						{project.notes.map((note) => <p class="r80-note">{note}</p>)}
						<div class="r80-chips">
							{project.tags.map((tag) => <span class="r80-chip">{tag}</span>)}
						</div>
						<div class="r80-link-row">
							<a class="r80-link" href={project.href} target="_blank" rel="noopener">
								{project.linkLabel}
							</a>
						</div>
					</div>
				</article>
			))
		}
	</div>

	<div style="margin-top:3rem">
		<p class="r80-label">Bonus levels</p>
		<h3 class="r80-chrome r80-h2">{shared.github.heading}</h3>
		<a class="r80-link" href={shared.github.profileUrl} target="_blank" rel="noopener">
			{shared.github.profileLinkLabel}
		</a>
		<div class="r80-repos">
			{
				repos.map((repo) => (
					<article class="r80-repo">
						<h4 class="r80-repo-name">{repo.name}</h4>
						<p class="r80-repo-desc">{repo.description}</p>
						<div class="r80-chips">
							{repo.language && <span class="r80-chip">{repo.language}</span>}
							{repo.topics.map((topic) => <span class="r80-chip">{topic}</span>)}
						</div>
						<p class="r80-meta">
							{repo.stars > 0 && <>{repo.stars} ★ &middot; </>}
							{shared.github.lastPushLabel} <FormattedDate date={repo.pushedAt} />
						</p>
						<div class="r80-link-row">
							<a class="r80-link" href={repo.repoUrl} target="_blank" rel="noopener">
								{shared.github.repoLinkLabel}
							</a>
							{
								repo.homepageUrl && (
									<a class="r80-link" href={repo.homepageUrl} target="_blank" rel="noopener">
										{shared.github.liveSiteLinkLabel}
									</a>
								)
							}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<section id="history" class="r80-shell r80-section">
	<p class="r80-label">High scores</p>
	<h2 class="r80-chrome r80-h2">{home.historyHeading}</h2>
	<div class="r80-scores">
		{
			home.history.map((entry, index) => (
				<div class="r80-score" data-current={entry.endYear === null ? 'true' : 'false'}>
					<span class="r80-rank">{String(index + 1).padStart(2, '0')}</span>
					<span>{entry.company}</span>
					<span class="r80-score-years">{entry.period}</span>
				</div>
			))
		}
	</div>
</section>
