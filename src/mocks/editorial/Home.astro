---
import FormattedDate from '../../components/FormattedDate.astro';
import { siteContent } from '../../data/site-content';

const { home, shared } = siteContent;
const [firstName, ...restName] = home.heroName.split(' ');
const repos = siteContent.fixtures.githubRepos;
---

<section class="ed-shell ed-hero">
	<div class="ed-hero-grid">
		<div>
			<p class="ed-standfirst">Portfolio &middot; Est. 1997</p>
			<h1 class="ed-hero-name">
				{firstName}
				<em>{restName.join(' ')}</em>
			</h1>
			<p class="ed-hero-deck">{home.taglines[0].text.replace('// ', '')}</p>
			<div class="ed-cta-row">
				{home.heroCtas.map((cta) => <a class="ed-btn" href={cta.href}>{cta.label}</a>)}
			</div>
		</div>
		<aside class="ed-hero-side">
			<p class="ed-standfirst">In this issue</p>
			<ul class="ed-hero-notes">
				{home.taglines.slice(1).map((tagline) => <li>{tagline.text.replace('// ', '')}</li>)}
				<li>{home.history.length} employers, {home.history.at(-1)?.startYear}&ndash;present</li>
			</ul>
		</aside>
	</div>
</section>

<section id="about" class="ed-shell ed-section">
	<p class="ed-kicker">{home.aboutHeading}</p>
	<div class="ed-split">
		<div>
			<div class="ed-prose ed-prose--dropcap">
				<p>
					{
						home.aboutBio.segments.map((segment) => {
							if (segment.kind === 'text') return segment.value;
							if (segment.kind === 'aside')
								return <span class="ed-aside">{segment.value}</span>;
							return <span class="ed-quote">{segment.value}</span>;
						})
					}
				</p>
			</div>
		</div>
		<aside class="ed-sidebar">
			<p class="ed-standfirst">Practice</p>
			{
				home.skillGroups.map((group) => (
					<div class="ed-skillgroup">
						<h3>{group.title}</h3>
						<p class="ed-skilllist">{group.skills.join(' · ')}</p>
					</div>
				))
			}
		</aside>
	</div>

	<div class="ed-pull">
		<p>{home.aboutCta.blurb}</p>
		<a class="ed-btn" href="/design-lab/editorial/about/">{home.aboutCta.link.label}</a>
	</div>
</section>

<section id="portfolio" class="ed-shell ed-section">
	<p class="ed-kicker">Features</p>
	<h2 class="ed-h2">{home.projectsHeading}</h2>
	<p class="ed-deck">{home.projectsSubhead}</p>

	<div class="ed-features">
		{
			home.featuredProjects.map((project, index) => (
				<article class="ed-feature">
					<p class="ed-plate">{String(index + 1).padStart(2, '0')}</p>
					<div>
						<h3 class="ed-feature-title">{project.name}</h3>
						<p class="ed-feature-summary">{project.summary}</p>
						{project.notes.map((note) => <p class="ed-footnote">{note}</p>)}
						<div class="ed-meta-row">
							<span>{project.tags.join(' / ')}</span>
							<a class="ed-link" href={project.href} target="_blank" rel="noopener">
								{project.linkLabel}
							</a>
						</div>
					</div>
					<figure class="ed-feature-media">
						{
							project.media.kind === 'image' ? (
								<img src={project.media.src} alt="" loading="lazy" />
							) : (
								<video src={project.media.src} autoplay muted loop playsinline />
							)
						}
					</figure>
				</article>
			))
		}
	</div>

	<div style="margin-top:4rem">
		<p class="ed-kicker">{shared.github.heading}</p>
		<a class="ed-link" href={shared.github.profileUrl} target="_blank" rel="noopener">
			{shared.github.profileLinkLabel}
		</a>
		<div class="ed-classifieds">
			{
				repos.map((repo) => (
					<article class="ed-classified">
						<h4>{repo.name}</h4>
						<p>{repo.description}</p>
						<p class="ed-classified-meta">
							{[repo.language, ...repo.topics].filter(Boolean).join(' · ')}
							{repo.stars > 0 && ` · ${repo.stars} ★`}
						</p>
						<p class="ed-classified-meta">
							{shared.github.lastPushLabel} <FormattedDate date={repo.pushedAt} />
						</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<section id="history" class="ed-shell ed-section">
	<p class="ed-kicker">Curriculum</p>
	<h2 class="ed-h2">{home.historyHeading.replace(' | ', ', ')}</h2>
	<div class="ed-ledger">
		{
			home.history.map((entry) => (
				<div class="ed-ledger-row" data-current={entry.endYear === null ? 'true' : 'false'}>
					<span class="ed-ledger-company">{entry.company}</span>
					<span class="ed-ledger-years">{entry.period}</span>
				</div>
			))
		}
	</div>
</section>
