---
import MockHead from '../_shared/MockHead.astro';
import { mockPageUrl, MOCK_PAGES, PAGE_LABELS, type MockPage } from '../registry';
import { siteContent } from '../../data/site-content';
import './editorial.css';

export interface Props {
	page: MockPage;
}

const { page } = Astro.props;
const { shared, meta } = siteContent;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<MockHead title={`${meta.siteTitle} — Editorial`} />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=Newsreader:ital,wght@0,400;0,500;1,400;1,500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="ed-root">
			<header class="ed-masthead">
				<div class="ed-shell ed-masthead-inner">
					<a class="ed-wordmark" href={mockPageUrl('editorial', 'home')}>{shared.logo}</a>
					<nav class="ed-nav">
						{
							MOCK_PAGES.map((p) => (
								<a
									href={mockPageUrl('editorial', p)}
									aria-current={p === page ? 'page' : undefined}
								>
									{PAGE_LABELS[p]}
								</a>
							))
						}
					</nav>
				</div>
			</header>

			<main>
				<slot />
			</main>

			<footer class="ed-shell ed-colophon">
				<p>{shared.copyright(year)}</p>
				<div class="ed-colophon-links">
					{
						shared.socials.map((social) => (
							<a href={social.href} aria-label={social.label} rel="noopener" target="_blank">
								{social.network}
							</a>
						))
					}
				</div>
			</footer>
		</div>
	</body>
</html>
