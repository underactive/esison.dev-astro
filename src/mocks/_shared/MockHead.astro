---
// Minimal <head> for design-lab mocks. Deliberately omits global.css, the
// design-*.css override sheets, Turnstile, Umami, canonical URL, OG/Twitter
// cards, and the sitemap/RSS links — mocks must be style-isolated and must not
// generate analytics events or social metadata.
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
