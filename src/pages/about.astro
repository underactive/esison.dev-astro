---
import MainLayout from '../layouts/MainLayout.astro';
import ContactModal from '../components/ContactModal.vue';
import CVModal from '../components/CVModal.vue';
import ImageModal from '../components/ImageModal.vue';
import { siteContent } from '../data/site-content';

const { about } = siteContent;
---

<MainLayout
	title="About Me"
	description="Learn more about my journey as a developer and the experiences that shape my work."
	page="about"
>
	<section class="term-shell term-page-head">
		<h1 class="term-h1">{about.heading}</h1>
		<p class="term-page-sub">cat ~/about.md</p>
	</section>

	<section class="term-shell term-section">
		<div class="term-prose">
			{about.workStory.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<div class="term-callout">
			<div>
				<h2 class="term-card-title">{about.collaborationCta.heading}</h2>
				<p style="margin-top:0.5rem">{about.collaborationCta.blurb}</p>
			</div>
			<div class="term-cta-row" style="margin-top:0">
				<button class="term-btn" type="button" data-open-modal="cv">
					{about.collaborationCta.actions[0].label}
				</button>
				<button class="term-btn" type="button" data-open-modal="contact">
					{about.collaborationCta.actions[1].label}
				</button>
			</div>
		</div>
	</section>

	<section class="term-shell term-section">
		<p class="term-section-label">cat ~/offline.md</p>
		<div class="term-prose">
			{about.personalStory.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<div class="term-photos">
			{
				about.photos.map((photo) => (
					<figure class="term-photo">
						<button
							type="button"
							data-open-image={photo.src}
							data-image-alt={photo.alt}
							data-image-caption={photo.caption}
						>
							<img src={photo.src} alt={photo.alt} loading="lazy" />
							<span class="term-sr-only">Enlarge: {photo.caption}</span>
						</button>
						<figcaption>{photo.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<ImageModal client:load />
	<CVModal client:load />
	<ContactModal client:load />

	<script>
		import { globalEventBus } from '../lib/eventBus';

		document.querySelectorAll<HTMLButtonElement>('[data-open-modal]').forEach((button) => {
			button.addEventListener('click', () => {
				globalEventBus.dispatchEvent(new Event(`show-${button.dataset.openModal}-modal`));
			});
		});

		document.querySelectorAll<HTMLButtonElement>('[data-open-image]').forEach((button) => {
			button.addEventListener('click', () => {
				(window as any).showImageModal?.({
					src: button.dataset.openImage,
					alt: button.dataset.imageAlt,
					caption: button.dataset.imageCaption,
				});
			});
		});
	</script>
</MainLayout>
