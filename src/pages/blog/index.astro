---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { siteContent } from '../../data/site-content';

const { blog } = siteContent;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<MainLayout title={`Blog - ${SITE_TITLE}`} description={blog.subhead} page="blog">
	<section class="term-shell term-page-head">
		<h1 class="term-h1">{blog.heading}</h1>
		<p class="term-page-sub">{blog.subhead}</p>
	</section>

	<section class="term-shell term-section">
		{
			posts.length > 0 ? (
				<div class="term-posts">
					{posts.map((post, index) => (
						<a
							class:list={['term-post', index === 0 && 'term-post--featured']}
							href={`/blog/${post.id}/`}
						>
							<span class="term-post-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<div>
								{index === 0 && <p class="term-post-flag">latest</p>}
								<h2 class="term-post-title">{post.data.title}</h2>
								{post.data.description && (
									<p class="term-post-desc">{post.data.description}</p>
								)}
								{post.data.updatedDate && (
									<p class="term-post-updated">
										updated <FormattedDate date={post.data.updatedDate} />
									</p>
								)}
								<p class="term-post-more">{blog.readMoreLabel} →</p>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="term-prose">
					<h2 class="term-h2">{blog.emptyState.heading}</h2>
					<p>{blog.emptyState.blurb}</p>
				</div>
			)
		}
	</section>
</MainLayout>
