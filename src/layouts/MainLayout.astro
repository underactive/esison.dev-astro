---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavPage } from '../lib/nav';

export interface Props {
	title: string;
	description: string;
	page?: NavPage;
}

const { title, description, page } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script is:inline>
			// Phosphor accent, applied before first paint to avoid a flash. Amber is
			// the :root default and needs no attribute, so an unknown stored value
			// falls through to amber instead of rendering unstyled accents.
			(function () {
				try {
					var stored = localStorage.getItem('phosphor');
					if (stored === 'green' || stored === 'cyan' || stored === 'white') {
						document.documentElement.setAttribute('data-phosphor', stored);
					}
				} catch (error) {
					/* localStorage unavailable; amber default applies */
				}
			})();
		</script>
	</head>
	<body>
		<a class="term-skip" href="#main">Skip to content</a>
		<Header page={page} />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
